# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/

# Environments
.venv/
venv/
env/
.env

# Temporary pipeline files
temp/
.cache/

# Large media files (prevent committing gigabytes of video to git)
raw/*
!raw/.gitkeep
!raw/processed/
raw/processed/*
!raw/processed/.gitkeep

out/*
!out/.gitkeep

# Global media file safeguard (blocks video/audio anywhere in the project)
*.mp4
*.mov
*.mkv
*.avi
*.webm
*.flv
*.wav
*.mp3
*.m4a
*.aac

# System & Editor
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

